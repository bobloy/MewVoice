{
  "name": "mewvoice",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mewvoice.com/api/*",
      "zone_name": "mewvoice.com"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.py"],
      "fallthrough": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "PACKS_BUCKET",
      "bucket_name": "mewvoice-packs"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mewvoice-db",
      "database_id": "88ac4dee-2974-4ae5-9f31-64a978e54cef"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://mewvoice.com"
  }
}
