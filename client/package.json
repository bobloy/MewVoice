{
  "name": "mewgenics-voice-pack",
  "private": true,
  "version": "0.1.1",
  "packageManager": "npm@11.11.0",
  "description": "Community voice pack creator for Mewgenics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
